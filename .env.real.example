# CSCID Exchange — REAL environment example
# Copy these variables into the REAL Vercel deployment.
# Never commit actual credentials or production secrets.

CSCID_EXCHANGE_ENV=real
NEXT_PUBLIC_CSCID_EXCHANGE_ENV=real

# Use the shared CSCID ledger database so shareholder ownership and balances stay consistent.
# Demo and Real sessions use separate cookies while the account ledger remains shared.
DATABASE_URL=

# Optional links used by the DEMO / REAL mode switch.
NEXT_PUBLIC_CSCID_DEMO_URL=
NEXT_PUBLIC_CSCID_REAL_URL=
